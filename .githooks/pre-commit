#!/bin/sh
# 提交前格式门禁：拒绝未格式化的提交。
#
# 本 hook 不随 clone 传播 —— 新克隆的机器必须执行一次：
#     git config core.hooksPath .githooks
#
# 只检查，不自动改写：自动 fmt 会把未预期的改动混进本次提交，掩盖真实内容。
# 想格式化就自己跑 `cargo fmt`（见仓库 AGENTS.md）。

set -e

if ! command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: 找不到 cargo，跳过格式检查（请确认 Rust 工具链已安装）" >&2
    exit 0
fi

# 注意：本仓通过 path 依赖 vxapo-driver，`cargo fmt --all` 会连带格式化 driver 的
# 445 个 hunk，使 driver 的文件出现在本仓提交里。故显式限定为本仓自有包，
# 保证「每个仓库只格式化自己的文件」。
if ! cargo fmt -p vxapo-cli -p vxapo-protocol -- --check >/dev/null 2>&1; then
    echo "" >&2
    echo "✗ 未通过 cargo fmt 检查，提交被拒绝。" >&2
    echo "" >&2
    echo "  请先运行：  cargo fmt -p vxapo-cli -p vxapo-protocol" >&2
    echo "  然后重新 git add 并提交。" >&2
    echo "" >&2
    echo "  查看具体差异：cargo fmt -p vxapo-cli -p vxapo-protocol -- --check" >&2
    echo "" >&2
    exit 1
fi

exit 0
